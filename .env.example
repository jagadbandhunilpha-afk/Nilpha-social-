# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (Part 2: Real Authentication & Profiles)
# Connect your Supabase project (https://supabase.com)
# Retrieve these values from: Project Settings -> API
# VITE_SUPABASE_URL: Your project URL (e.g., https://your-project-id.supabase.co)
VITE_SUPABASE_URL=""

# VITE_SUPABASE_ANON_KEY: Your project public anonymous key (anon/public key)
# Never expose the service_role key in client environment variables!
VITE_SUPABASE_ANON_KEY=""

# ============================================================================
# PART 5: CALLING & LIVE STREAMING PROVIDER CONFIGURATION
# ============================================================================
# Calling provider abstraction: 'webrtc' (browser P2P) or 'livekit' (managed SFU)
VITE_CALLING_PROVIDER="webrtc"

# Managed Calling Service (LiveKit / Daily / Agora)
# If using LiveKit for multi-party group calls:
# VITE_LIVEKIT_URL="wss://your-livekit-instance.livekit.cloud"

# Server-Side Secrets ONLY (e.g., Supabase Edge Functions or Trusted Backend):
# NEVER expose API secrets or token-generation keys in frontend client variables!
# LIVEKIT_API_KEY="your_livekit_api_key"
# LIVEKIT_API_SECRET="your_livekit_api_secret"

# Live Streaming Broadcast Provider (RTMP / HLS / Ingress)
# LIVE_STREAMING_INGRESS_URL="rtmp://ingress.your-streaming-provider.com/live"
