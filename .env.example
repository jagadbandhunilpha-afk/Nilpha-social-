# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ============================================================================
# SUPABASE CONFIGURATION (Part 9: Real Authentication & Database)
# ============================================================================
# Connect your Supabase project (https://supabase.com/dashboard)
# In Supabase: Project Settings -> API
# Note: In Vercel, set these in Project Settings -> Environment Variables,
# then trigger a "Redeploy" so Vite inlines them into the production build.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-client-key

# Note: Modern Supabase projects also support:
# VITE_SUPABASE_PUBLISHABLE_KEY=your-public-client-key
# (The application seamlessly supports both variable names)

# ============================================================================
# PART 5: CALLING & LIVE STREAMING PROVIDER CONFIGURATION
# ============================================================================
# Calling provider abstraction: 'webrtc' (browser P2P) or 'livekit' (managed SFU)
VITE_CALLING_PROVIDER="webrtc"

# Managed Calling Service (LiveKit / Daily / Agora) - Optional
# VITE_LIVEKIT_URL="wss://your-livekit-instance.livekit.cloud"

# Server-Side Secrets ONLY (e.g., Supabase Edge Functions or Trusted Backend):
# NEVER expose API secrets or token-generation keys in frontend client variables!
# LIVEKIT_API_KEY="your_livekit_api_key"
# LIVEKIT_API_SECRET="your_livekit_api_secret"
